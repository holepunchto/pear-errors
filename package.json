{
  "name": "pear-errors",
  "version": "1.0.1",
  "main": "index.js",
  "type": "commonjs",
  "description": "Pear Core Error Types",
  "license": "Apache-2.0",
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:node && npm run test:bare",
    "test:node": "brittle-node test/all.js",
    "test:bare": "brittle-bare test/all.js",
    "test:gen": "brittle -r test/all.js test/*.test.js"
  },
  "devDependencies": {
    "brittle": "^3.5.0",
    "lunte": "^1.0.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^1.0.0"
  }
}
